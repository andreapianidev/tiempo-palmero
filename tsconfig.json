{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["src", "scripts", "api", "vite.config.ts"],
  // Los `*.native.ts` son la mitad móvil de un par (ver `dem-loader.ts`): los
  // compila Metro con las dependencias de `mobile/`, no Vite.
  "exclude": ["src/**/*.native.ts"]
}
