{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["src", "scripts", "api", "vite.config.ts"],
  // Los tres scripts que abren un navegador de verdad quedan fuera por una
  // dependencia que no es de este proyecto: necesitan Playwright para
  // preguntarle a MapLibre qué considera tapado, o para contar lo que sale por
  // el cable. Playwright NO es dependencia de este proyecto y no tiene por qué
  // serlo —se ejecutan a mano, una vez cada vez que se toca lo que miden, y no
  // entran en el paquete—, pero sin excluirlos `tsc --noEmit` los busca y el
  // despliegue se cae. Cómo ejecutarlos está en la cabecera de cada uno.
  //
  // ESTA LISTA HAY QUE ACTUALIZARLA AL AÑADIR UNO, y se olvida: el despliegue
  // de `precarga-intencion.ts` se cayó por no estar aquí, con un `npm run
  // build` que en local pasaba porque Playwright sí estaba instalado. En local
  // no se nota nunca; solo se nota en Vercel.
  "exclude": [
    "scripts/checks/occlusion-margin.ts",
    "scripts/checks/tile-cache.ts",
    "scripts/checks/precarga-intencion.ts",
    "scripts/checks/portada-regimenes.ts"
  ]
}
