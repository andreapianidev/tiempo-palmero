{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["src", "scripts", "api", "vite.config.ts"],
  // `occlusion-margin.ts` y `tile-cache.ts` quedan fuera por una dependencia
  // que no es de este proyecto: necesitan Playwright para abrir un navegador de verdad y
  // preguntarle a MapLibre qué considera tapado. Playwright NO es dependencia
  // de este proyecto y no tiene por qué serlo —se ejecuta a mano, una vez cada
  // vez que se toca el umbral, y no entra en el paquete—, pero sin excluirlo
  // `tsc --noEmit` lo busca y el despliegue se cae. Cómo ejecutarlo está en la
  // cabecera del propio script.
  "exclude": ["scripts/checks/occlusion-margin.ts", "scripts/checks/tile-cache.ts"]
}
