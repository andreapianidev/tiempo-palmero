{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "react-jsx",
    // Metro prefiere `*.native.ts` sobre `*.ts`; TypeScript necesita que se lo
    // digan. Sin esto, aquí se comprobaría el cargador de DEM del navegador.
    "moduleSuffixes": [".native", ""],
    "paths": {
      "@core/*": ["../src/*"],
      // El núcleo tipa el estilo del mapa contra `maplibre-gl`, que es el
      // paquete de la web. En el móvil el mismo tipo lo publica el binding
      // nativo, así que aquí ese nombre apunta ahí: `buildStyle()` devuelve
      // exactamente lo que espera la prop `mapStyle`, sin castings.
      "maplibre-gl": ["./node_modules/@maplibre/maplibre-react-native"],
      // El cargador nativo del DEM vive en `../src`, fuera de este proyecto, y
      // desde allí TypeScript no encuentra las dependencias del móvil.
      "@shopify/react-native-skia": ["./node_modules/@shopify/react-native-skia"],
      "expo-file-system": ["./node_modules/expo-file-system"]
    }
  },
  // Solo los ficheros de la app. Lo que se importe de `@core/*` entra solo,
  // por la propia resolución de módulos, y así no se compila la mitad web del
  // repositorio —que sí usa el DOM— con los tipos de React Native.
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
