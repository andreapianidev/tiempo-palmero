{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "tiempo-palmero.vercel.app" }],
      "destination": "https://app.tiempopalmero.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "tiempo-palmero.vercel.app" }],
      "destination": "https://app.tiempopalmero.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/dem/(.*).png",
      "headers": [{ "key": "cache-control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/dem/manifest.json",
      "headers": [{ "key": "cache-control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/layers/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=86400, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "cache-control", "value": "public, max-age=0, must-revalidate" },
        { "key": "service-worker-allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "content-type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "cache-control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/api/co2",
      "headers": [{ "key": "cache-control", "value": "public, s-maxage=30" }]
    }
  ]
}
