{
  "name": "tiempo-palmero",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Meteorología interpolada a alta resolución para la isla de La Palma, construida sobre los datos abiertos del Cabildo Insular.",
  "license": "Apache-2.0",
  "author": "Andrea Piani <andreapiani.dev@gmail.com> (https://www.andreapiani.com)",
  "homepage": "https://tiempo-palmero.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreapianidev/tiempo-palmero.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare-data": "tsx scripts/prepare-data.ts",
    "prepare-data:snapshot": "tsx scripts/prepare-data.ts --only=snapshot",
    "prepare-ocean": "tsx scripts/prepare-ocean.ts",
    "desktop:core": "node desktop/scripts/bundle-core.mjs",
    "desktop:golden": "node desktop/scripts/gen-golden.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "esbuild": "^0.25.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
